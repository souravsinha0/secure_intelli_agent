LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

ONPREM_MODEL_NAME=gpt-oss-20b
ONPREM_BASE_URL=http://10.52.1.13:8000/v1
ONPREM_API_KEY=

NGROK_AUTHTOKEN=
NGROK_DOMAIN=

